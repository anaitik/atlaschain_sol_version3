# Example .env file for AtlasChain
# Copy this to `.env` and fill in values (do NOT commit your .env).
# Use strong secrets for production and prefer a secrets manager for long-term storage.

# Application (required in production)
# Generate a secure SECRET_KEY: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=change-me-to-a-strong-secret

# Optional admin auto-creation (set for dev convenience). If empty, create admin manually.
ADMIN_PASSWORD=ChangeMeNow123!

# Token expiration (minutes)
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Algorand blockchain (for anchoring)
# ALGOD_TOKEN: optional (required if using a private node or indexer)
ALGONODE_URL=https://testnet-api.algonode.cloud
ALGOD_TOKEN=
# ALGORAND_ADDRESS and ALGORAND_MNEMONIC are sensitive: set only for development/testing.
# DO NOT commit production mnemonics or private keys into source control.
ALGORAND_ADDRESS=
ALGORAND_MNEMONIC=

# External APIs
# GOOGLE_API_KEY: used by LLM/google integrations (keep secret)
GOOGLE_API_KEY=

# Frontend (Vite) - Vite exposes env vars prefixed with VITE_ to the client
VITE_API_URL=http://localhost:8000

# Notes:
#  - After copying to .env, modify values with your real secrets.
#  - This file is an example and should not contain real production secrets.
#  - Add `.env` to .gitignore (already included) so secrets are not committed.
